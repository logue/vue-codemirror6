{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "include": ["env.d.ts", "rstack.config.*", "package.json"],
  "exclude": ["**/node_modules", "**/.*/"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./.rstack/.tmp/tsconfig.node.tsbuildinfo"
  }
}
