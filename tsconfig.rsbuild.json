{
  "extends": "./tsconfig.rslib.json",
  "include": ["env.d.ts", "src/**/*", "src-demo/**/*"],
  "exclude": ["**/node_modules", "**/.*/", "src/**/__tests__/*"],
  "compilerOptions": {
    "outDir": "demo",
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rootDir": "./",
    "tsBuildInfoFile": "./.rstack/tsconfig.rsbuild.tsbuildinfo"
  }
}
