{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "vue-codemirror6",
  "version": "1.7.0",
  "description": "CodeMirror6 Component for vue2 and vue3.",
  "keywords": [
    "vuejs",
    "vue",
    "vue-components",
    "vue-codemirror",
    "code-editor",
    "text-editor",
    "vue2",
    "vue3",
    "web-editor",
    "vue-plugin",
    "vue-component",
    "codemirror-editor",
    "vue-resource",
    "codemirror6"
  ],
  "homepage": "https://github.com/logue/vue-codemirror6",
  "bugs": {
    "url": "https://github.com/logue/vue-codemirror6/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/logue/vue-codemirror6.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "import": "./dist/index.umd.js",
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "rslib --watch",
    "dev:demo": "rsbuild --open",
    "lint": "run-s 'lint:*' --",
    "lint:biome": "biome check --write",
    "lint:rslint": "rslint . --fix",
    "analyze": "RSDOCTOR=true rslib",
    "analyze:demo": "RSDOCTOR=true rsbuild",
    "inspect": "rslib inspect",
    "inspect:demo": "rsbuild inspect",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf demo dist docs",
    "clean:hard": "rimraf demo dist docs node_modules/.tmp node_modules/.cache",
    "build": "rslib build",
    "build:demo": "rsbuild build",
    "preview": "rsbuild preview",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "dependencies": {
    "vue-demi": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/markdown": "^8.0.3",
    "@logue/biome-plugins": "^0.0.3",
    "@microsoft/api-extractor": "^7.59.1",
    "@rsbuild/core": "^2.2.8",
    "@rsbuild/plugin-node-polyfill": "^1.4.6",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@rslib/core": "^1.0.1",
    "@rslint/core": "^0.9.3",
    "@rstest/adapter-rsbuild": "^0.12.0",
    "@rstest/adapter-rslib": "^0.12.0",
    "@rstest/core": "^0.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.2",
    "@vue-devtools-rstack/rsbuild": "^0.1.0",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "bootstrap": "^5.3.8",
    "codemirror": "^6.0.2",
    "eslint-linter-browserify": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-markdown-wasm": "^1.0.1",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "codemirror": "^6.0.0",
    "style-mod": "^4.0.0",
    "vue": "^2.7.14 || ^3.3.4"
  },
  "packageManager": "pnpm@12.5.1"
}
