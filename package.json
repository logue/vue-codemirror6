{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "vue-codemirror6",
  "version": "1.8.0",
  "description": "CodeMirror6 Component for vue2 and vue3.",
  "keywords": [
    "vuejs",
    "vue",
    "vue-components",
    "vue-codemirror",
    "code-editor",
    "text-editor",
    "vue2",
    "vue3",
    "web-editor",
    "vue-plugin",
    "vue-component",
    "codemirror-editor",
    "vue-resource",
    "codemirror6"
  ],
  "homepage": "https://github.com/logue/vue-codemirror6",
  "bugs": {
    "url": "https://github.com/logue/vue-codemirror6/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/logue/vue-codemirror6.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "sideEffects": [
    "./dist/wc-auto.es.js",
    "./src/wc-auto.ts",
    "./dist/wc-auto.umd.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./wc": {
      "types": "./dist/wc.d.ts",
      "import": "./dist/wc.es.js",
      "default": "./dist/wc.es.js"
    },
    "./wc-auto": {
      "types": "./dist/wc-auto.d.ts",
      "import": "./dist/wc-auto.es.js",
      "default": "./dist/wc-auto.es.js"
    },
    "./umd": {
      "import": "./dist/index.umd.js",
      "default": "./dist/index.umd.js"
    },
    "./wc/umd": {
      "import": "./dist/wc.umd.js",
      "default": "./dist/wc.umd.js"
    },
    "./wc-auto/umd": {
      "import": "./dist/wc-auto.umd.js",
      "default": "./dist/wc-auto.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "rs dev --open",
    "dev:docs": "pnpm run build:demo && rs doc",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rs lint . --fix",
    "lint:prettier": "rs fmt .",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "clean": "rimraf dist docs src-docs/public/demo",
    "clean:hard": "rimraf .rstack/cache .rstack/.rsdoctor demo dist docs node_modules/.tmp node_modules/.cache",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:demo": "rs build",
    "build:docs": "run-s build:demo build:rspress",
    "build:rspress": "rs doc build",
    "preview": "rs preview",
    "preview:docs": "rs doc preview",
    "analyze": "cross-env RSDOCTOR=true rs lib",
    "build-only": "rs lib",
    "type-check": "vize check --tsconfig tsconfig.rslib.json",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "skills:install": "npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m'",
    "skills:update": "npx skills update",
    "prepare": "rs hooks"
  },
  "dependencies": {
    "vue-demi": "latest"
  },
  "devDependencies": {
    "@carbon/styles": "^1.119.0",
    "@carbon/type": "^11.71.0",
    "@carbon/web-components": "^2.67.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@rsbuild/plugin-node-polyfill": "^1.4.6",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rsdoctor/agent-cli": "^0.1.1",
    "@rsdoctor/core": "^2.0.2",
    "@rspress/core": "^2.1.2",
    "@sableclient/twemoji-font": "^1.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue-devtools-rstack/rsbuild": "^0.1.0",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "codemirror": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-linter-browserify": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.0.4",
    "prettier-plugin-yaml": "^1.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "rstack": "^0.9.1",
    "taze": "^21.3.0",
    "typescript": "^7.0.2",
    "vize": "^0.744.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-markdown-wasm": "^1.0.1"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "codemirror": "^6.0.0",
    "style-mod": "^4.0.0",
    "vue": "^2.7.14 || ^3.3.4"
  },
  "packageManager": "pnpm@12.18.0"
}
